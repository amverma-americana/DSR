{
  // ---------------------------------------------------------------------------------------------
  // TEMPLATE. Copy this file to appsettings.Development.json (which is .gitignored) and fill it in.
  //
  //     cp appsettings.Development.example.json appsettings.Development.json
  //
  // The real file is not committed because it carries a JWT signing key and a connection string.
  // ---------------------------------------------------------------------------------------------

  "ConnectionStrings": {
    // LocalDB is the zero-install default. For a full SQL Server instance use:
    //   "Server=.;Database=DSRResourceManagement;Trusted_Connection=True;TrustServerCertificate=True"
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=DSRResourceManagement;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },

  "Jwt": {
    // Minimum 32 bytes for HS256; the app refuses to start below that.
    // Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
    // NEVER reuse a development key in a deployed environment.
    "SigningKey": "replace-with-your-own-local-key-at-least-32-bytes-long-0123456789",
    "AllowHttp": true
  },

  "Database": { "EnableSensitiveDataLogging": true },
  "Swagger": { "Enabled": true }
}
