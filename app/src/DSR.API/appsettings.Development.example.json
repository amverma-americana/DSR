{
  // ---------------------------------------------------------------------------------------------
  // TEMPLATE. Copy this file to appsettings.Development.json (which is .gitignored) and fill it in.
  //
  //     cp appsettings.Development.example.json appsettings.Development.json
  //
  // The real file is not committed because it carries a JWT signing key and a connection string.
  // ---------------------------------------------------------------------------------------------

  "ConnectionStrings": {
    // Points at the LOCAL SQL SERVER instance (localhost / "."), NOT LocalDB.
    //
    // Use the SAME instance you connect to in SSMS. LocalDB
    // (Server=(localdb)\MSSQLLocalDB) is a separate engine whose databases do NOT appear when SSMS
    // is connected to "localhost" -- so the app writes rows that are invisible in your query
    // window, and new users look like they vanished when in fact they saved to the other instance.
    //
    // Encrypt/TrustServerCertificate are required because Microsoft.Data.SqlClient now defaults to
    // Encrypt=True and a local developer instance usually has only a self-signed certificate.
    "DefaultConnection": "Server=localhost;Database=DSRResourceManagement;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True"

    // LocalDB alternative, only if you deliberately want an isolated instance and will point SSMS
    // at "(localdb)\MSSQLLocalDB" as well:
    // "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=DSRResourceManagement;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },

  "Jwt": {
    // Minimum 32 bytes for HS256; the app refuses to start below that.
    // Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
    // NEVER reuse a development key in a deployed environment.
    "SigningKey": "replace-with-your-own-local-key-at-least-32-bytes-long-0123456789",
    "AllowHttp": true
  },

  "Database": { "EnableSensitiveDataLogging": true },
  "Swagger": { "Enabled": true }
}
