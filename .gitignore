# ------------------------------------------------------------------- SECRETS
#
# appsettings.json IS committed: it holds placeholders only
# ("REPLACE-THIS-WITH-A-32-BYTE-MINIMUM-SECRET-FROM-A-SECRET-STORE").
#
# Environment-specific overrides are NOT committed, because they hold real
# connection strings and JWT signing keys. Copy the .example file and fill it in.
appsettings.Development.json
appsettings.Production.json
appsettings.Staging.json
appsettings.*.local.json
